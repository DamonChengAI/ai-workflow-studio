{
  "name": "ai-workflow-studio",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Mock-only AI workflow production studio for task orchestration demos.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "tsx scripts/validate-sample.ts",
    "demo": "tsx scripts/run-demo.ts",
    "agent:demo": "tsx scripts/agent-demo.ts",
    "video:assets": "tsx scripts/render-video-assets.ts",
    "video:export": "tsx scripts/export-video-run.ts",
    "video:recover-media": "tsx scripts/recover-media-failure.ts",
    "real-media:smoke": "tsx scripts/real-media-smoke.ts",
    "real-audio:smoke": "tsx scripts/real-audio-smoke.ts",
    "video:compose": "tsx scripts/compose-video.ts",
    "video:check": "tsx scripts/check-video-run.ts",
    "security:check": "tsx scripts/security-check.ts",
    "video:report": "tsx scripts/render-video-run-report.ts",
    "hook:check": "tsx scripts/hook-check.ts",
    "check": "npm run build && npm run validate && npm run demo && npm run video:assets && npm run video:compose && REQUIRE_REAL_IMAGES=1 REQUIRE_REAL_AUDIO=1 REQUIRE_RESEARCH=1 npm run video:check && npm run security:check && npm run video:report && npm run hook:check && npm test",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
